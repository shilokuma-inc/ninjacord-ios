          "stringUnit" : {
            "state" : "translated",
            "value" : "許可すると、あなたの興味に合った広告が表示されやすくなります。許可しなくても、アプリの機能はすべて使えます。"
          }
        }
      }
    }
  },
  "version" : "1.0"
